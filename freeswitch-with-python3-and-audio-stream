# RUN update-alternatives --install /usr/local/bin/python python /usr/bin/python3  1

# copy uv installed python to container
COPY python-3.11 /usr/local/python-3.11

# Enable modules
RUN cd /usr/src/freeswitch && ./bootstrap.sh -j
RUN cd /usr/src/freeswitch && ./configure --with-python3=/usr/local/python-3.11/bin/python3.11
RUN sed -i 's|#formats/mod_shout|formats/mod_shout|' /usr/src/freeswitch/modules.conf
RUN sed -i 's@#languages/mod_python3@languages/mod_python3@g' /usr/src/freeswitch/modules.conf
RUN sed -i 's@#say/mod_say_zh@say/mod_say_zh@g' /usr/src/freeswitch/modules.conf

RUN cd /usr/src/freeswitch && make -j`nproc` && make install



