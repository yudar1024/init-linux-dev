WORKDIR /root
RUN git clone https://github.com/amigniter/mod_audio_stream.git /root/mod_audio_stream
RUN DEBIAN_FRONTEND=noninteractive apt-get -yq install libssl-dev zlib1g-dev libspeexdsp-dev libevent-dev
WORKDIR /root/mod_audio_stream
RUN git submodule init
WORKDIR /root/mod_audio_stream
RUN git submodule update
WORKDIR /root/mod_audio_stream
RUN mkdir build
WORKDIR /root/mod_audio_stream/build
RUN export PKG_CONFIG_PATH=/usr/local/freeswitch/lib/pkgconfig && export FS_PKGCONFIG=/usr/local/freeswitch/lib/pkgconfig &&cmake -DCMAKE_BUILD_TYPE=Release ..
RUN export PKG_CONFIG_PATH=/usr/local/freeswitch/lib/pkgconfig && export FS_PKGCONFIG=/usr/local/freeswitch/lib/pkgconfig && make install
ENTRYPOINT ["/bin/sh","-c","/usr/local/freeswitch/bin/freeswitch", "-base", "/usr/local/freeswitch", "-rp","-c"]
